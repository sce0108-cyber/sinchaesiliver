<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>sinchaesilver</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <header class="header">
    <h1>🎬 sinchaesilver</h1>
    <form id="search-form" class="search-form">
      <input
        type="text"
        id="search-input"
        placeholder="영화 제목을 입력하세요 (예: 인터스텔라)"
        autocomplete="off"
        required
      />
      <button type="submit">검색</button>
    </form>
    <nav class="tabs">
      <button class="tab-btn active" data-tab="search">검색 결과</button>
      <button class="tab-btn" data-tab="wishlist">
        찜 목록 <span id="wishlist-count">(0)</span>
      </button>
    </nav>
  </header>

  <main>
    <section id="search-tab" class="tab-content active">
      <p id="search-status" class="status-message"></p>
      <div id="search-results" class="movie-grid"></div>
    </section>

    <section id="wishlist-tab" class="tab-content">
      <p id="wishlist-status" class="status-message"></p>
      <div id="wishlist-results" class="movie-grid"></div>
    </section>
  </main>

  <script src="/js/main.js"></script>
</body>
</html>
